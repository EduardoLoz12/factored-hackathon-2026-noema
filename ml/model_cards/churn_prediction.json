{
  "model_name": "Customer Churn Prediction Model (V2 - Fixed)",
  "version": "2.0",
  "task": "Classification",
  "description": "Predicts whether a customer is likely to churn. Fixed target leakage and structural nulls.",
  "target_variable": "customer_status in ('Closed', 'Suspended', 'Inactive')",
  "features": [
    "segment",
    "occupation",
    "marital_status",
    "education_level",
    "credit_score",
    "estimated_monthly_income_usd",
    "product_count",
    "total_balance_usd",
    "days_past_due",
    "tenure_days"
  ],
  "model_type": "RandomForestClassifier(class_weight='balanced')",
  "metrics": {
    "Accuracy": 0.8419532509403547,
    "Precision": 0.15165876777251186,
    "Recall": 0.014505893019038985,
    "F1-Score": 0.026479106330161355
  },
  "author": "Antigravity (Post-Audit)"
}
