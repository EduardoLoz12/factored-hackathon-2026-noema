# Copiar a .env y rellenar. NUNCA commitear .env.
# Las llaves de AWS vienen en el PDF del reto repartido a ~800 participantes:
# se tratan como comprometidas por diseño, son read-only, y SOLO se usan en la ingesta local.
# Nunca viajan al contenedor de la API ni al frontend.

# --- Fuente de datos (solo ingesta local) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=
S3_PREFIX=data/

# --- Rutas locales ---
DATA_DIR=./data
DUCKDB_PATH=./data/noema.duckdb

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Databricks (lakehouse + MLflow) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=noema
DATABRICKS_SCHEMA=bronze
DATABRICKS_VOLUME=raw

# --- Serving ---
DATABASE_URL=
JWT_SECRET=
PII_HASH_SALT=

# --- Banderas ---
SCM_ENABLED=true
LOG_LEVEL=INFO
ENV=local
